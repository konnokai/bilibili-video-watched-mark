{
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "name": "Bilibili 觀看進度標記",
  "version": "0.1.0",
  "description": "在 Bilibili 影片縮圖顯示本機保存的最後播放進度。",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://api.bilibili.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bilibili 觀看進度標記",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://t.bilibili.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
